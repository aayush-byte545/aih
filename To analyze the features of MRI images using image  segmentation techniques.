
# =====================================================
# MRI IMAGE SEGMENTATION USING OPENCV
# AI for Healthcare Lab
# =====================================================

import cv2
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

# =====================================================
# STEP 1: LOAD MRI IMAGE
# =====================================================

BASE_DIR = Path(__file__).resolve().parent
image_path = BASE_DIR / "mri_image.jpg"

image = cv2.imread(str(image_path))

# Check whether the image was read successfully
if image is None:
    raise FileNotFoundError(
        f"Could not read image: {image_path}\n"
        "Place your MRI image in the same folder as this Python file "
        "and name it mri_image.jpg."
    )

print("MRI image loaded successfully!")

# =====================================================
# STEP 2: CONVERT BGR TO RGB
# =====================================================

image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

# =====================================================
# STEP 3: CONVERT TO GRAYSCALE
# =====================================================

gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)

# =====================================================
# STEP 4: APPLY GAUSSIAN BLUR
# =====================================================

blur = cv2.GaussianBlur(gray, (5, 5), 0)

# =====================================================
# STEP 5: APPLY OTSU THRESHOLDING
# =====================================================

ret, segmented = cv2.threshold(
    blur,
    0,
    255,
    cv2.THRESH_BINARY + cv2.THRESH_OTSU
)

# =====================================================
# STEP 6: DETECT CONTOURS
# =====================================================

contours, hierarchy = cv2.findContours(
    segmented,
    cv2.RETR_EXTERNAL,
    cv2.CHAIN_APPROX_SIMPLE
)

# =====================================================
# STEP 7: DRAW CONTOURS
# =====================================================

output = image.copy()

cv2.drawContours(
    output,
    contours,
    -1,
    (255, 0, 0),
    2
)

# =====================================================
# STEP 8: DISPLAY ALL RESULTS
# =====================================================

plt.figure(figsize=(15, 10))

# Original MRI
plt.subplot(2, 3, 1)
plt.imshow(image)
plt.title("Original MRI")
plt.axis("off")

# Grayscale
plt.subplot(2, 3, 2)
plt.imshow(gray, cmap="gray")
plt.title("Grayscale")
plt.axis("off")

# Gaussian Blur
plt.subplot(2, 3, 3)
plt.imshow(blur, cmap="gray")
plt.title("Gaussian Blur")
plt.axis("off")

# Otsu Segmentation
plt.subplot(2, 3, 4)
plt.imshow(segmented, cmap="gray")
plt.title("Otsu Segmentation")
plt.axis("off")

# Detected Contours
plt.subplot(2, 3, 5)
plt.imshow(output)
plt.title("Detected Contours")
plt.axis("off")

# Final Segmented Image
plt.subplot(2, 3, 6)
plt.imshow(segmented, cmap="gray")
plt.title("Final Segmented Image")
plt.axis("off")

plt.tight_layout()
plt.show()

# =====================================================
# STEP 9: PRINT MRI IMAGE FEATURES
# =====================================================

print("\n----- MRI Image Features -----")

print("Image Size:", image.shape)
print("Otsu Threshold:", ret)
print("Number of Contours:", len(contours))

if len(contours) > 0:

    # Find the largest contour
    largest_contour = max(
        contours,
        key=cv2.contourArea
    )

    # Calculate area and perimeter
    area = cv2.contourArea(largest_contour)

    perimeter = cv2.arcLength(
        largest_contour,
        True
    )

    # Calculate bounding rectangle
    x, y, w, h = cv2.boundingRect(
        largest_contour
    )

    print("Largest Region Area:", area)
    print("Largest Region Perimeter:", perimeter)

    print("\nBounding Box:")
    print("X:", x)
    print("Y:", y)
    print("Width:", w)
    print("Height:", h)

else:
    print("No contours detected.")

print("\nMRI image processing completed successfully!")
